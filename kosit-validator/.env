# Environment Variables
# KoSIT Validator (XRechnung 3.0.2 / EN16931, validator 1.6.3, config 2026-01-31)
# Pinned tag - Arcane auto-updates only :latest
KOSIT_IMAGE=apps4everything/kosit-validator-xrechnung:3.0.2-3
# Host port (LAN access); n8n uses http://kosit-validator:8081 via Docker network
KOSIT_HOST_PORT=8081
# Java heap (CT has 2 GB RAM)
JAVA_XMS=128m
JAVA_XMX=512m
# Container memory limit (heap + metaspace/overhead)
KOSIT_MEM_LIMIT=900m
# External Docker network of the n8n stack
N8N_NETWORK=n8n_default
